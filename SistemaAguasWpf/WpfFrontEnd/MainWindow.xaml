<Window x:Class="WpfFrontEnd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Águas"
        Width="1400"
        Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>

        <!-- Estilo dos botões do menu lateral -->
        <Style x:Key="MenuButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="50"/>

            <Setter Property="Margin"
                    Value="0,0,0,12"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#20A9D2"/>

            <Setter Property="BorderBrush"
                    Value="#72D8F3"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Quando o rato passa pelo botão -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#056C8F"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="White"/>

                            </Trigger>

                            <!-- Quando o botão é pressionado -->
                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#034E69"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Estilo do botão Sobre -->
        <Style x:Key="AboutButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MenuButtonStyle}">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Margin"
                    Value="12"/>

            <Setter Property="Background"
                    Value="#0B91BA"/>

        </Style>

        <!-- Estilo do botão Sair -->
        <!-- Estilo dos botões do submenu -->
        <Style x:Key="SubMenuButtonStyle"
       TargetType="Button">

            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="10,2,0,5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#0F95BE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#72D8F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="SubMenuBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">

                            <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="SubMenuBorder"
                                Property="Background"
                                Value="#056C8F"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="SubMenuBorder"
                                Property="Background"
                                Value="#034E69"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Estilo do botão Sair -->
        <Style x:Key="ExitButtonStyle"
       TargetType="Button">

            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#E9F5F9"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ExitBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ExitBorder"
                                Property="Background"
                                Value="#C9EAF3"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="ExitBorder"
                                Property="Background"
                                Value="#A8D9E7"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="233"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="1147*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MENU LATERAL -->
        <Border Grid.RowSpan="2"
                Grid.Column="0"
                Background="#087EA4"
                Grid.ColumnSpan="2">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="75"/>
                </Grid.RowDefinitions>

                <!-- LOGÓTIPO -->
                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center">
                    <Image Source="Images/Logo.png"
                           Width="251"
                           Height="133"
                           Stretch="Uniform" RenderTransformOrigin="0.3,0.02">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0.114"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                </StackPanel>

                <!-- BOTÕES PRINCIPAIS -->
                <StackPanel Grid.Row="1"
                            Margin="12,10">

                    <!-- CLIENTES -->
                    <StackPanel>

                        <Button Style="{StaticResource MenuButtonStyle}"
                            Click="BtnClientes_Click">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="Images/user-solid.png"
                                   Width="25"
                                   Height="25"
                                   Margin="0,0,14,0"/>

                                <TextBlock Text="Clientes"
                       VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        <!-- SUBMENU CLIENTES -->
                        <StackPanel x:Name="SubMenuClientes"
                        Visibility="Collapsed"
                        Margin="25,-5,0,10">

                            <Button Style="{StaticResource SubMenuButtonStyle}"
                        Content="Novo Cliente"
                        Click="BtnNovoCliente_Click"/>

                            <Button Style="{StaticResource SubMenuButtonStyle}"
                        Content="Editar Cliente"
                        Click="BtnEditarCliente_Click"/>

                            <Button Style="{StaticResource SubMenuButtonStyle}"
                        Content="Apagar Cliente"
                        Click="BtnApagarCliente_Click"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- CONTADORES -->
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Click="BtnContadores_Click">

                        <StackPanel Orientation="Horizontal">

                            <Image Source="Images/Contador.png"
                                   Width="40"
                                   Height="50"
                                   Margin="0,0,12,0"
                                   Stretch="Uniform"/>

                            <TextBlock Text=" Contadores"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <!-- CONSUMOS -->
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Click="BtnConsumos_Click">

                        <StackPanel Orientation="Horizontal">

                            <Image Source="Images/ContaInserir.png"
                                   Width="45"
                                   Height="45"
                                   Margin="0,0,12,0"
                                   Stretch="Uniform"/>

                            <TextBlock Text="Consumos"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <!-- FATURAS -->
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Click="BtnFaturas_Click">

                        <StackPanel Orientation="Horizontal">

                            <Image Source="Images/Fatura.png"
                                   Width="40"
                                   Height="30"
                                   Margin="0,0,12,0"
                                   Stretch="Uniform"/>

                            <TextBlock Text=" Faturas"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <!-- BOTÃO SOBRE -->
                <Button Grid.Row="2"
                        Style="{StaticResource AboutButtonStyle}"
                        Click="BtnSobre_Click">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Image Source="Images/circle-info-branco.png"
                               Width="24"
                               Height="24"
                               Margin="0,0,10,0"
                               Stretch="Uniform"/>
                        <TextBlock Text="Sobre" Width="78"
                                   />

                    </StackPanel>

                </Button>

            </Grid>

        </Border>

        <!-- BARRA SUPERIOR -->
        <Border Grid.Row="0"
                Grid.Column="2"
                Background="#087EA4"
                BorderBrush="#DCE5EA"
                BorderThickness="0,0,0,1" Grid.ColumnSpan="2">

            <Grid Margin="25,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Bem-vindo"
                               FontSize="14"
                               Foreground="#DDF6FC"/>

                    <TextBlock Text="Sistema de Gestão de Águas"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                </StackPanel>

                <!-- BOTÃO SAIR -->
                <Button Grid.Column="1"
                        Style="{StaticResource ExitButtonStyle}"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Click="BtnSair_Click">

                    <Image Source="Images/shutdown_50px.png"
                           Width="30"
                           Height="30"
                           Stretch="Uniform"/>

                </Button>

            </Grid>

        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Row="1"
              Grid.Column="3"
              Margin="7,20,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="17*"/>
                <ColumnDefinition Width="138*"/>
            </Grid.ColumnDefinitions>

            <Border Background="LightGray"
                    CornerRadius="12"
                    Padding="20" Grid.ColumnSpan="2" Margin="-38,-30,-23,-20">

                <ContentControl x:Name="conteudoPrincipal" Margin="-20,-20,0,0"/>

            </Border>

        </Grid>

    </Grid>

</Window>