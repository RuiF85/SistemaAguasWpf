<UserControl x:Class="WpfFrontEnd.Views.Clientes.ApagarClienteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF4F7" Width="791">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Apagar Cliente"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#083B5C"/>

            <TextBlock Text="Selecione o cliente que pretende remover."
                       FontSize="15"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- Lista de clientes -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D7E2E8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Clientes registados"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#083B5C"/>

                <DataGrid x:Name="dgClientes"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeaderWidth="0"
                          AlternatingRowBackground="#F4F8FA"
                          SelectionChanged="DgClientes_SelectionChanged">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding IdCliente}"
                                            Width="70"/>

                        <DataGridTextColumn Header="Nome"
                                            Binding="{Binding Nome}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Apelido"
                                            Binding="{Binding Apelido}"
                                            Width="*"/>

                        <DataGridTextColumn Header="NIF"
                                            Binding="{Binding Nif}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Contacto"
                                            Binding="{Binding Contacto}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            Width="2*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <!-- Dados selecionados -->
        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#D7E2E8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="25">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="Cliente selecionado"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#083B5C"
                           Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Nome:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="lblNome"
                           Grid.Row="1"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="NIF:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="lblNif"
                           Grid.Row="2"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Contacto:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="lblContacto"
                           Grid.Row="3"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Email:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="lblEmail"
                           Grid.Row="4"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                    <Button Content="Cancelar"
                            Width="120"
                            Height="40"
                            Margin="0,0,10,0"
                            Click="BtnCancelar_Click"/>

                    <Button Content="Apagar Cliente"
                            Width="150"
                            Height="40"
                            Background="#C0392B"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="BtnApagarCliente_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>