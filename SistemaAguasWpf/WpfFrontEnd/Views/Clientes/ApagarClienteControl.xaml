<UserControl x:Class="WpfFrontEnd.Views.Clientes.ApagarClienteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gif="http://wpfanimatedgif.codeplex.com"
             Background="#EEF4F7"
             MinWidth="850">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- CORES                                                 -->
        <!-- ===================================================== -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#147FA3"/>

        <SolidColorBrush x:Key="DarkBlueBrush"
                         Color="#083B5C"/>

        <SolidColorBrush x:Key="DangerBrush"
                         Color="#C0392B"/>

        <SolidColorBrush x:Key="DangerHoverBrush"
                         Color="#D94B3D"/>

        <SolidColorBrush x:Key="DangerPressedBrush"
                         Color="#922B21"/>


        <!-- ===================================================== -->
        <!-- ETIQUETAS                                             -->
        <!-- ===================================================== -->

        <Style x:Key="InfoLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#31566B"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ===================================================== -->
        <!-- VALORES DO CLIENTE                                    -->
        <!-- ===================================================== -->

        <Style x:Key="InfoValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#243B4A"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

        </Style>


        <!-- ===================================================== -->
        <!-- BOTÃO SECUNDÁRIO                                      -->
        <!-- ===================================================== -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#31566B"/>

            <Setter Property="Background"
                    Value="#E8F1F5"/>

            <Setter Property="BorderBrush"
                    Value="#BDD2DC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D5E8EF"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#83B8CA"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#BFDCE6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- BOTÃO APAGAR                                          -->
        <!-- ===================================================== -->

        <Style x:Key="DangerButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="165"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource DangerBrush}"/>

            <Setter Property="BorderBrush"
                    Value="#E57368"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <Border.Effect>

                                <DropShadowEffect Color="#922B21"
                                                  BlurRadius="8"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Opacity="0.25"/>

                            </Border.Effect>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <!-- Ícone do caixote -->

                                <Path Data="M7,7 L17,7
                                           M9,7 L10,4 L14,4 L15,7
                                           M8,9 L9,21 L15,21 L16,9
                                           M11,11 L11,18
                                           M13,11 L13,18"
                                      Width="18"
                                      Height="18"
                                      Margin="0,0,8,0"
                                      Stretch="Uniform"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>

                                <ContentPresenter VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerHoverBrush}"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#F3A199"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerPressedBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- DATAGRID                                              -->
        <!-- ===================================================== -->

        <Style x:Key="ModernDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E3EBEF"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#F5F9FB"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="RowHeaderWidth"
                    Value="0"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="#294654"/>

            <Setter Property="RowHeight"
                    Value="42"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="42"/>

        </Style>


        <!-- Cabeçalhos da tabela -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#E8F3F7"/>

            <Setter Property="Foreground"
                    Value="#16445B"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="BorderBrush"
                    Value="#D2E1E7"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- Linhas da tabela -->

        <Style TargetType="DataGridRow">

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#EAF6FA"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F7D7D3"/>

                    <Setter Property="Foreground"
                            Value="#74261E"/>

                    <Setter Property="FontWeight"
                            Value="SemiBold"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- Células -->

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="Foreground"
                            Value="#74261E"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- CONTEÚDO                                                  -->
    <!-- ========================================================= -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="35">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="25"/>

                <RowDefinition Height="290"/>

                <RowDefinition Height="25"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- CABEÇALHO                                         -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">

                <!-- Ícone de apagar -->

                <Border Width="48"
                        Height="48"
                        Background="#FBE9E7"
                        CornerRadius="24"
                        Margin="0,0,14,0">

                    <Path Data="M7,7 L17,7
                               M9,7 L10,4 L14,4 L15,7
                               M8,9 L9,21 L15,21 L16,9
                               M11,11 L11,18
                               M13,11 L13,18"
                          Width="25"
                          Height="25"
                          Stretch="Uniform"
                          Stroke="#C0392B"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

                </Border>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Apagar Cliente"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource DarkBlueBrush}"/>

                    <TextBlock Text="Selecione o cliente que pretende remover."
                               FontSize="14"
                               Foreground="#6D818D"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </StackPanel>


            <!-- ================================================= -->
            <!-- LISTA DE CLIENTES                                 -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#D7E2E8"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22">

                <Border.Effect>

                    <DropShadowEffect Color="#000000"
                                      BlurRadius="10"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.10"/>

                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="16"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- Cabeçalho da lista -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Clientes registados"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#153F57"/>

                            <TextBlock Text="Clique numa linha para selecionar o cliente."
                                       FontSize="12"
                                       Foreground="#82939D"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#FBE9E7"
                                BorderBrush="#F2C6C1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,7"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#C0392B"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock Text="A eliminação é permanente"
                                           FontSize="12"
                                           Foreground="#8D332A"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- TABELA -->

                    <Border Grid.Row="2"
                            BorderBrush="#D8E4E9"
                            BorderThickness="1"
                            CornerRadius="9"
                            ClipToBounds="True">

                        <DataGrid x:Name="dgClientes"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  SelectionChanged="DgClientes_SelectionChanged">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding IdCliente}"
                                                    Width="65"/>

                                <DataGridTextColumn Header="Nome"
                                                    Binding="{Binding Nome}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Apelido"
                                                    Binding="{Binding Apelido}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="NIF"
                                                    Binding="{Binding Nif}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Contacto"
                                                    Binding="{Binding Contacto}"
                                                    Width="125"/>

                                <DataGridTextColumn Header="Email"
                                                    Binding="{Binding Email}"
                                                    Width="1.7*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- CLIENTE SELECIONADO                               -->
            <!-- ================================================= -->

            <Border Grid.Row="4"
                    Background="White"
                    BorderBrush="#D7E2E8"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="30"
                    Margin="0,0,0,20">

                <Border.Effect>

                    <DropShadowEffect Color="#000000"
                                      BlurRadius="10"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.10"/>

                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="20"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="22"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="28"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- Título -->

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Cliente selecionado"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#153F57"/>

                        <TextBlock Text="Confirme cuidadosamente os dados antes de apagar."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="#82939D"/>

                    </StackPanel>


                    <!-- Aviso -->

                    <Border Grid.Row="2"
                            Background="#FFF5F4"
                            BorderBrush="#F1C5C0"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="14">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="12"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Width="32"
                                    Height="32"
                                    Background="#FADBD8"
                                    CornerRadius="16"
                                    VerticalAlignment="Center">

                                <TextBlock Text="!"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#C0392B"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Atenção"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#922B21"/>

                                <TextBlock Text="Esta operação remove definitivamente o cliente selecionado."
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="#A04A42"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- DADOS -->

                    <Border Grid.Row="4"
                            Background="#F7FAFB"
                            BorderBrush="#D9E5EA"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="30"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="18"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <!-- NOME -->

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0">

                                <TextBlock Text="Nome"
                                           Style="{StaticResource InfoLabelStyle}"/>

                                <Border Margin="0,7,0,0"
                                        Height="42"
                                        Padding="12,0"
                                        Background="White"
                                        BorderBrush="#D3E0E6"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <TextBlock x:Name="lblNome"
                                               Style="{StaticResource InfoValueStyle}"/>

                                </Border>

                            </StackPanel>


                            <!-- NIF -->

                            <StackPanel Grid.Row="0"
                                        Grid.Column="2">

                                <TextBlock Text="NIF"
                                           Style="{StaticResource InfoLabelStyle}"/>

                                <Border Margin="0,7,0,0"
                                        Height="42"
                                        Padding="12,0"
                                        Background="White"
                                        BorderBrush="#D3E0E6"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <TextBlock x:Name="lblNif"
                                               Style="{StaticResource InfoValueStyle}"/>

                                </Border>

                            </StackPanel>


                            <!-- CONTACTO -->

                            <StackPanel Grid.Row="2"
                                        Grid.Column="0">

                                <TextBlock Text="Contacto"
                                           Style="{StaticResource InfoLabelStyle}"/>

                                <Border Margin="0,7,0,0"
                                        Height="42"
                                        Padding="12,0"
                                        Background="White"
                                        BorderBrush="#D3E0E6"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <TextBlock x:Name="lblContacto"
                                               Style="{StaticResource InfoValueStyle}"/>

                                </Border>

                            </StackPanel>


                            <!-- EMAIL -->

                            <StackPanel Grid.Row="2"
                                        Grid.Column="2">

                                <TextBlock Text="Email"
                                           Style="{StaticResource InfoLabelStyle}"/>

                                <Border Margin="0,7,0,0"
                                        MinHeight="42"
                                        Padding="12,8"
                                        Background="White"
                                        BorderBrush="#D3E0E6"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <TextBlock x:Name="lblEmail"
                                               Style="{StaticResource InfoValueStyle}"/>

                                </Border>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- BOTÕES -->

                    <Grid Grid.Row="6">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Selecione um cliente para ativar a eliminação."
                                   FontSize="12"
                                   Foreground="#82939D"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="Cancelar"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,12,0"
                                    Click="BtnCancelar_Click"/>

                            <Button Content="Apagar cliente"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="BtnApagarCliente_Click"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>