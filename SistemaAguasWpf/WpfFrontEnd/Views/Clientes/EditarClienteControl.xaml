<UserControl x:Class="WpfFrontEnd.Views.Clientes.EditarClienteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF4F7"
             MinWidth="850">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- CORES                                                 -->
        <!-- ===================================================== -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#147FA3"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#1998C2"/>

        <SolidColorBrush x:Key="PrimaryPressedBrush"
                         Color="#075C7A"/>

        <SolidColorBrush x:Key="DarkBlueBrush"
                         Color="#083B5C"/>

        <SolidColorBrush x:Key="LightBlueBrush"
                         Color="#5EC4E3"/>

        <SolidColorBrush x:Key="InputBorderBrush"
                         Color="#C9D8E0"/>

        <SolidColorBrush x:Key="InputBackgroundBrush"
                         Color="#F9FBFC"/>


        <!-- ===================================================== -->
        <!-- ETIQUETAS                                             -->
        <!-- ===================================================== -->

        <Style x:Key="FormLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#284A5E"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ===================================================== -->
        <!-- CAIXAS DE TEXTO                                       -->
        <!-- ===================================================== -->

        <Style x:Key="ModernTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#243B4A"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource InputBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="SelectionBrush"
                    Value="#8FD8EC"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#81BED1"/>

                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>

                                <Setter TargetName="InputBorder"
                                        Property="BorderThickness"
                                        Value="2"/>

                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="#E9EFF2"/>

                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.7"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- CHECKBOX                                              -->
        <!-- ===================================================== -->

        <Style x:Key="ModernCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#284A5E"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <StackPanel Orientation="Horizontal">

                            <Border x:Name="CheckBorder"
                                    Width="22"
                                    Height="22"
                                    Background="White"
                                    BorderBrush="#AFC5D0"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    VerticalAlignment="Center">

                                <Path x:Name="CheckMark"
                                      Data="M 4 10 L 8 14 L 17 5"
                                      Stroke="White"
                                      StrokeThickness="2.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>

                            </Border>

                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>

                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="CheckBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>

                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>

                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- BOTÃO SECUNDÁRIO                                      -->
        <!-- ===================================================== -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#31566B"/>

            <Setter Property="Background"
                    Value="#E8F1F5"/>

            <Setter Property="BorderBrush"
                    Value="#BDD2DC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D5E8EF"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#83B8CA"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#BFDCE6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- BOTÃO PRINCIPAL                                       -->
        <!-- ===================================================== -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="175"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource LightBlueBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <Border.Effect>

                                <DropShadowEffect Color="#147FA3"
                                                  BlurRadius="8"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Opacity="0.22"/>

                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#B9EFFB"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryPressedBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- DATAGRID                                              -->
        <!-- ===================================================== -->

        <Style x:Key="ModernDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E3EBEF"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#F5F9FB"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="RowHeaderWidth"
                    Value="0"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="#294654"/>

            <Setter Property="RowHeight"
                    Value="42"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="42"/>

        </Style>


        <!-- Cabeçalho das colunas -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#E8F3F7"/>

            <Setter Property="Foreground"
                    Value="#16445B"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="BorderBrush"
                    Value="#D2E1E7"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- Linhas -->

        <Style TargetType="DataGridRow">

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#EAF6FA"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#BFE9F5"/>

                    <Setter Property="Foreground"
                            Value="#083B5C"/>

                    <Setter Property="FontWeight"
                            Value="SemiBold"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- Células -->

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="Foreground"
                            Value="#083B5C"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- CONTEÚDO                                                  -->
    <!-- ========================================================= -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="35">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="25"/>

                <RowDefinition Height="280"/>

                <RowDefinition Height="25"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- CABEÇALHO                                         -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">

                <!-- Ícone de edição -->

                <Border Width="48"
                        Height="48"
                        Background="#DDF3F9"
                        CornerRadius="24"
                        Margin="0,0,14,0">

                    <Grid>

                        <Path Data="M6,18 L6,22 L10,22 L21,11 L17,7 Z
                                   M15.5,8.5 L19.5,12.5"
                              Width="25"
                              Height="25"
                              Stretch="Uniform"
                              Stroke="#147FA3"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                    </Grid>

                </Border>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Editar Cliente"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource DarkBlueBrush}"/>

                    <TextBlock Text="Selecione um cliente e altere os dados pretendidos."
                               FontSize="14"
                               Foreground="#6D818D"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </StackPanel>


            <!-- ================================================= -->
            <!-- LISTA DE CLIENTES                                 -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#D7E2E8"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22">

                <Border.Effect>

                    <DropShadowEffect Color="#000000"
                                      BlurRadius="10"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.10"/>

                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="16"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- Cabeçalho da lista -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Clientes registados"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#153F57"/>

                            <TextBlock Text="Clique numa linha para carregar os dados do cliente."
                                       FontSize="12"
                                       Foreground="#82939D"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#EDF7FA"
                                BorderBrush="#D1E6ED"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,7"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#20A9D2"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock Text="Selecione um cliente"
                                           FontSize="12"
                                           Foreground="#31566B"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- TABELA -->

                    <Border Grid.Row="2"
                            BorderBrush="#D8E4E9"
                            BorderThickness="1"
                            CornerRadius="9"
                            ClipToBounds="True">

                        <DataGrid x:Name="dgClientes"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  SelectionChanged="DgClientes_SelectionChanged">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding IdCliente}"
                                                    Width="65"/>

                                <DataGridTextColumn Header="Nome"
                                                    Binding="{Binding Nome}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Apelido"
                                                    Binding="{Binding Apelido}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="NIF"
                                                    Binding="{Binding Nif}"
                                                    Width="105"/>

                                <DataGridTextColumn Header="Contacto"
                                                    Binding="{Binding Contacto}"
                                                    Width="125"/>

                                <DataGridTextColumn Header="Email"
                                                    Binding="{Binding Email}"
                                                    Width="1.6*"/>

                                <DataGridCheckBoxColumn Header="Ativo"
                                                        Binding="{Binding Ativo}"
                                                        Width="75"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- FORMULÁRIO                                        -->
            <!-- ================================================= -->

            <Border Grid.Row="4"
                    Background="White"
                    BorderBrush="#D7E2E8"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="30"
                    Margin="0,0,0,20">

                <Border.Effect>

                    <DropShadowEffect Color="#000000"
                                      BlurRadius="10"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.10"/>

                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="22"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="28"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- TÍTULO DO CARTÃO -->

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Dados do cliente selecionado"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#153F57"/>

                        <TextBlock Text="Os campos ficam disponíveis depois de selecionar um cliente."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="#82939D"/>

                    </StackPanel>


                    <!-- CAMPOS -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="30"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="20"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="20"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="20"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="20"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- NOME -->

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0">

                            <TextBlock Text="Nome *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtNome"
                                     Margin="0,7,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="60"/>

                        </StackPanel>


                        <!-- APELIDO -->

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2">

                            <TextBlock Text="Apelido *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtApelido"
                                     Margin="0,7,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="60"/>

                        </StackPanel>


                        <!-- NIF -->

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0">

                            <TextBlock Text="NIF *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtNif"
                                     Margin="0,7,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="9"/>

                        </StackPanel>


                        <!-- CONTACTO -->

                        <StackPanel Grid.Row="2"
                                    Grid.Column="2">

                            <TextBlock Text="Contacto"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtContacto"
                                     Margin="0,7,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="15"/>

                        </StackPanel>


                        <!-- EMAIL -->

                        <StackPanel Grid.Row="4"
                                    Grid.Column="0">

                            <TextBlock Text="Email"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtEmail"
                                     Margin="0,7,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="100"/>

                        </StackPanel>


                        <!-- MORADA -->

                        <StackPanel Grid.Row="4"
                                    Grid.Column="2">

                            <TextBlock Text="Morada *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtMorada"
                                     Margin="0,7,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="150"/>

                        </StackPanel>


                        <!-- CÓDIGO POSTAL -->

                        <StackPanel Grid.Row="6"
                                    Grid.Column="0">

                            <TextBlock Text="Código Postal *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtCodigoPostal"
                                     Margin="0,7,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="8"/>

                        </StackPanel>


                        <!-- LOCALIDADE -->

                        <StackPanel Grid.Row="6"
                                    Grid.Column="2">

                            <TextBlock Text="Localidade *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtLocalidade"
                                     Margin="0,7,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="80"/>

                        </StackPanel>


                        <!-- ESTADO -->

                        <Border Grid.Row="8"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Padding="15"
                                Background="#F2F8FA"
                                BorderBrush="#D4E4EA"
                                BorderThickness="1"
                                CornerRadius="9">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Estado do cliente"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#284A5E"/>

                                    <TextBlock Text="Desativar um cliente não elimina o respetivo registo."
                                               Margin="0,4,15,0"
                                               FontSize="12"
                                               Foreground="#778D99"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                                <CheckBox x:Name="chkAtivo"
                                          Grid.Column="1"
                                          Content="Cliente ativo"
                                          Style="{StaticResource ModernCheckBoxStyle}"/>

                            </Grid>

                        </Border>

                    </Grid>


                    <!-- BOTÕES -->

                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Confirme as alterações antes de guardar."
                                   FontSize="12"
                                   Foreground="#82939D"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="Cancelar"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,12,0"
                                    Click="BtnCancelar_Click"/>

                            <Button Content="Guardar alterações"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnGuardarAlteracoes_Click"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>