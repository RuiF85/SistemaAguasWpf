<UserControl x:Class="WpfFrontEnd.Views.Clientes.NovoClienteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF4F7" Width="690">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel>

            <TextBlock Text="Novo Cliente"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#083B5C"/>

            <TextBlock Text="Preencha os dados para registar um novo cliente."
                       FontSize="15"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- Formulário -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="25"
                BorderBrush="#D7E2E8"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <!-- Nome -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Nome:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtNome"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                <!-- Apelido -->
                <TextBlock Grid.Row="0"
                           Grid.Column="3"
                           Text="Apelido:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtApelido"
                         Grid.Row="0"
                         Grid.Column="4"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                <!-- NIF -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="NIF:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtNif"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                <!-- Contacto -->
                <TextBlock Grid.Row="1"
                           Grid.Column="3"
                           Text="Contacto:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtContacto"
                         Grid.Row="1"
                         Grid.Column="4"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                <!-- Email -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Email:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtEmail"
                         Grid.Row="2"
                         Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                <!-- Morada -->
                <TextBlock Grid.Row="2"
                           Grid.Column="3"
                           Text="Morada:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtMorada"
                         Grid.Row="2"
                         Grid.Column="4"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                <!-- Código Postal -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Código Postal:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtCodigoPostal"
                         Grid.Row="3"
                         Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                <!-- Localidade -->
                <TextBlock Grid.Row="3"
                           Grid.Column="3"
                           Text="Localidade:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtLocalidade"
                         Grid.Row="3"
                         Grid.Column="4"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                <!-- Estado -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Estado:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <CheckBox x:Name="chkAtivo"
                          Grid.Row="4"
                          Grid.Column="1"
                          Content="Cliente ativo"
                          IsChecked="True"
                          VerticalAlignment="Center"/>

                <!-- Botões -->
                <StackPanel Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="Limpar"
                            Width="110"
                            Height="38"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Click="BtnLimpar_Click"/>

                    <Button Content="Guardar"
                            Width="110"
                            Height="38"
                            Background="#20A9D2"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BtnGuardar_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>