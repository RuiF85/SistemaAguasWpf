<UserControl x:Class="WpfFrontEnd.Views.Clientes.NovoClienteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF4F7"
             MinWidth="760">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- CORES                                                 -->
        <!-- ===================================================== -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#147FA3"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#1998C2"/>

        <SolidColorBrush x:Key="PrimaryPressedBrush"
                         Color="#075C7A"/>

        <SolidColorBrush x:Key="DarkBlueBrush"
                         Color="#083B5C"/>

        <SolidColorBrush x:Key="LightBlueBrush"
                         Color="#5EC4E3"/>


        <!-- ===================================================== -->
        <!-- TEXTO DAS ETIQUETAS                                   -->
        <!-- ===================================================== -->

        <Style x:Key="FormLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#36586A"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="2,0,0,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- CAIXAS DE TEXTO                                       -->
        <!-- ===================================================== -->

        <Style x:Key="ModernTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#243B4A"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#BFD0D9"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="SelectionBrush"
                    Value="#8FD8EC"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Grid>

                            <!-- Sombra suave da caixa -->

                            <Border x:Name="ShadowBorder"
                                    Margin="0,2,0,0"
                                    Background="White"
                                    CornerRadius="10">

                                <Border.Effect>

                                    <DropShadowEffect Color="#517180"
                                                      BlurRadius="5"
                                                      ShadowDepth="1"
                                                      Direction="270"
                                                      Opacity="0.10"/>

                                </Border.Effect>

                            </Border>


                            <!-- Caixa principal -->

                            <Border x:Name="InputBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">

                                <Grid>

                                    <Border Height="1"
                                            Margin="10,0"
                                            Background="White"
                                            Opacity="0.9"
                                            VerticalAlignment="Top"/>

                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <!-- Rato sobre o campo -->

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#75B5C9"/>

                                <Setter TargetName="ShadowBorder"
                                        Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect Color="#147FA3"
                                                          BlurRadius="6"
                                                          ShadowDepth="1"
                                                          Direction="270"
                                                          Opacity="0.14"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>


                            <!-- Campo selecionado -->

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>

                                <Setter TargetName="InputBorder"
                                        Property="BorderThickness"
                                        Value="2"/>

                                <Setter TargetName="ShadowBorder"
                                        Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect Color="#147FA3"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.22"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>


                            <!-- Campo desativado -->

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="#EEF3F5"/>

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#D5E0E5"/>

                                <Setter TargetName="ShadowBorder"
                                        Property="Effect"
                                        Value="{x:Null}"/>

                                <Setter Property="Foreground"
                                        Value="#80919A"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- CHECKBOX                                              -->
        <!-- ===================================================== -->

        <Style x:Key="ModernCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#284A5E"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <StackPanel Orientation="Horizontal">

                            <Border x:Name="CheckBorder"
                                    Width="22"
                                    Height="22"
                                    Background="White"
                                    BorderBrush="#AFC5D0"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    VerticalAlignment="Center">

                                <Path x:Name="CheckMark"
                                      Data="M 4 10 L 8 14 L 17 5"
                                      Stroke="White"
                                      StrokeThickness="2.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>

                            </Border>

                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>

                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="CheckBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>

                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>

                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- BOTÃO SECUNDÁRIO                                      -->
        <!-- ===================================================== -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#31566B"/>

            <Setter Property="Background"
                    Value="#E8F1F5"/>

            <Setter Property="BorderBrush"
                    Value="#BDD2DC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D5E8EF"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#83B8CA"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#BFDCE6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- BOTÃO PRINCIPAL                                       -->
        <!-- ===================================================== -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="130"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource LightBlueBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <Border.Effect>

                                <DropShadowEffect Color="#147FA3"
                                                  BlurRadius="8"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Opacity="0.22"/>

                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#B9EFFB"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryPressedBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- CONTEÚDO                                                  -->
    <!-- ========================================================= -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="35">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="25"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- CABEÇALHO                                         -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0">

                <StackPanel Orientation="Horizontal">

                    <Border Width="48"
                            Height="48"
                            Background="#DDF3F9"
                            CornerRadius="24"
                            Margin="0,0,14,0">

                        <Path Data="M12,4 A4,4 0 1 1 11.99,4
                                   M4,22 C4.3,16.5 7.4,13 12,13
                                   C16.6,13 19.7,16.5 20,22"
                              Width="25"
                              Height="25"
                              Stretch="Uniform"
                              Stroke="#147FA3"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Novo Cliente"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DarkBlueBrush}"/>

                        <TextBlock Text="Preencha os dados para registar um novo cliente."
                                   FontSize="14"
                                   Foreground="#6D818D"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>


            <!-- ================================================= -->
            <!-- CARTÃO DO FORMULÁRIO                              -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="14"
                    Padding="30"
                    BorderBrush="#D7E2E8"
                    BorderThickness="1"
                    MaxWidth="1050"
                    HorizontalAlignment="Stretch">

                <Border.Effect>

                    <DropShadowEffect Color="#000000"
                                      BlurRadius="10"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.10"/>

                </Border.Effect>


                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="22"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="28"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- TÍTULO DO CARTÃO -->

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Dados pessoais"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#153F57"/>

                        <TextBlock Text="Os campos assinalados com * são obrigatórios."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="#82939D"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- CAMPOS                                            -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="30"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="21"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="21"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="21"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="21"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- NOME -->

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0">

                            <TextBlock Text="Nome *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtNome"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="60"/>

                        </StackPanel>


                        <!-- APELIDO -->

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2">

                            <TextBlock Text="Apelido *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtApelido"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="60"/>

                        </StackPanel>


                        <!-- NIF -->

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0">

                            <TextBlock Text="NIF *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtNif"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="9"/>

                        </StackPanel>


                        <!-- CONTACTO -->

                        <StackPanel Grid.Row="2"
                                    Grid.Column="2">

                            <TextBlock Text="Contacto*"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtContacto"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="15"/>

                        </StackPanel>


                        <!-- EMAIL -->

                        <StackPanel Grid.Row="4"
                                    Grid.Column="0">

                            <TextBlock Text="Email*"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtEmail"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="100"/>

                        </StackPanel>


                        <!-- MORADA -->

                        <StackPanel Grid.Row="4"
                                    Grid.Column="2">

                            <TextBlock Text="Morada *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtMorada"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="150"/>

                        </StackPanel>


                        <!-- CÓDIGO POSTAL -->

                        <StackPanel Grid.Row="6"
                                    Grid.Column="0">

                            <TextBlock Text="Código Postal * 0000-000"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtCodigoPostal"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="8"/>

                        </StackPanel>


                        <!-- LOCALIDADE -->

                        <StackPanel Grid.Row="6"
                                    Grid.Column="2">

                            <TextBlock Text="Localidade *"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtLocalidade"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="80"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- ESTADO DO CLIENTE                                 -->
                        <!-- ================================================= -->

                        <Border Grid.Row="8"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Padding="15"
                                Background="#F2F8FA"
                                BorderBrush="#D4E4EA"
                                BorderThickness="1"
                                CornerRadius="9">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Estado do cliente"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#284A5E"/>

                                    <TextBlock Text="Um cliente inativo permanece registado, mas não fica disponível para novas operações."
                                               Margin="0,4,15,0"
                                               FontSize="12"
                                               Foreground="#778D99"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                                <CheckBox x:Name="chkAtivo"
                                          Grid.Column="1"
                                          Content="Cliente ativo"
                                          IsChecked="True"
                                          Style="{StaticResource ModernCheckBoxStyle}"/>

                            </Grid>

                        </Border>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- BOTÕES                                            -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Confirme os dados antes de guardar."
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#82939D"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="Limpar"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,12,0"
                                    Click="BtnLimpar_Click"/>

                            <Button Content="Guardar cliente"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnGuardar_Click"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>