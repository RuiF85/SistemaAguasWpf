<UserControl x:Class="WpfFrontEnd.Views.Contadores.NovoContadorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF4F7" Width="772"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             >

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Novo Contador"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#083B5C"/>

            <TextBlock Text="Registe um novo contador e associe-o a um cliente."
                       FontSize="15"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Formulário -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D7E2E8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="30">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <!-- Cliente -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Cliente:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="cmbClientes"
                          Grid.Row="0"
                          Grid.Column="1"
                          Height="36"
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="NomeCompleto"
                          SelectedValuePath="IdCliente"/>

                <!-- Número -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Número do contador:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtNumeroContador"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="36"
                         VerticalContentAlignment="Center"/>

                <!-- Data -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Data de instalação:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <DatePicker x:Name="dpDataInstalacao"
                            Grid.Row="2"
                            Grid.Column="1"
                            Height="36"
                            VerticalContentAlignment="Center"
                            DisplayDateEnd="{x:Static sys:DateTime.Today}"/>

                <!-- Ativo -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Ativo:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <CheckBox x:Name="chkAtivo"
                          Grid.Row="3"
                          Grid.Column="1"
                          IsChecked="True"
                          VerticalAlignment="Center"/>

                <!-- Botões -->
                <StackPanel Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                    <Button Content="Limpar"
                            Width="110"
                            Height="40"
                            Margin="0,0,10,0"
                            Click="BtnLimpar_Click"/>

                    <Button Content="Guardar"
                            Width="130"
                            Height="40"
                            Background="#087EA4"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="BtnGuardar_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</UserControl>