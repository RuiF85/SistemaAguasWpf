<UserControl x:Class="WpfFrontEnd.Views.Contadores.NovoContadorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#EEF4F7"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="850">

    <UserControl.Resources>

        <!-- CORES -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#147FA3"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#1998C2"/>

        <SolidColorBrush x:Key="PrimaryPressedBrush"
                         Color="#075C7A"/>

        <SolidColorBrush x:Key="DarkBlueBrush"
                         Color="#083B5C"/>

        <SolidColorBrush x:Key="InputBorderBrush"
                         Color="#C9D8E0"/>

        <SolidColorBrush x:Key="InputBackgroundBrush"
                         Color="#F9FBFC"/>


        <!-- RÓTULOS -->

        <Style x:Key="FormLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#284A5E"/>

        </Style>


        <!-- TEXTBOX -->

        <Style x:Key="ModernTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#243B4A"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource InputBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="SelectionBrush"
                    Value="#8FD8EC"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="White"/>

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#81BED1"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="White"/>

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>

                                <Setter TargetName="InputBorder"
                                        Property="BorderThickness"
                                        Value="2"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="#EDF2F4"/>

                                <Setter Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- COMBOBOX -->

        <Style x:Key="ModernComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#243B4A"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource InputBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="White"/>

                    <Setter Property="BorderBrush"
                            Value="#81BED1"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="Background"
                            Value="White"/>

                    <Setter Property="BorderBrush"
                            Value="{StaticResource PrimaryBrush}"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Background"
                            Value="#EDF2F4"/>

                    <Setter Property="Opacity"
                            Value="0.65"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- DATEPICKER -->

        <Style x:Key="ModernDatePickerStyle"
               TargetType="DatePicker">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#243B4A"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource InputBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Resources>

                <Style TargetType="DatePickerTextBox">

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="BorderThickness"
                            Value="0"/>

                    <Setter Property="Padding"
                            Value="10,0"/>

                    <Setter Property="VerticalContentAlignment"
                            Value="Center"/>

                </Style>

            </Style.Resources>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="White"/>

                    <Setter Property="BorderBrush"
                            Value="#81BED1"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="Background"
                            Value="White"/>

                    <Setter Property="BorderBrush"
                            Value="{StaticResource PrimaryBrush}"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- CHECKBOX -->

        <Style x:Key="ModernCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#284A5E"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <StackPanel Orientation="Horizontal">

                            <Border x:Name="CheckBorder"
                                    Width="22"
                                    Height="22"
                                    Background="White"
                                    BorderBrush="#B8CBD4"
                                    BorderThickness="1.5"
                                    CornerRadius="5">

                                <Path x:Name="CheckMark"
                                      Data="M4,10 L8,14 L17,5"
                                      Width="13"
                                      Height="10"
                                      Stretch="Fill"
                                      Stroke="White"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                            </Border>

                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>

                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="CheckBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>

                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>

                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- BOTÃO SECUNDÁRIO -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#31566B"/>

            <Setter Property="Background"
                    Value="#E8F1F5"/>

            <Setter Property="BorderBrush"
                    Value="#BDD2DC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D5E8EF"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#83B8CA"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#BFDCE6"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- BOTÃO PRINCIPAL -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="140"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="#5EC4E3"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <Border.Effect>

                                <DropShadowEffect Color="#147FA3"
                                                  BlurRadius="8"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Opacity="0.22"/>

                            </Border.Effect>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <Path Data="M5,4 L19,4 L19,20 L5,20 Z
                                           M8,4 L8,10 L16,10 L16,4
                                           M8,14 L16,14
                                           M8,17 L14,17"
                                      Width="18"
                                      Height="18"
                                      Margin="0,0,8,0"
                                      Stretch="Uniform"
                                      Stroke="White"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>

                                <ContentPresenter VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#B9EFFB"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryPressedBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="35">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="25"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- CABEÇALHO -->

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">

                <Border Width="48"
                        Height="48"
                        Background="#DDF3F9"
                        CornerRadius="24"
                        Margin="0,0,14,0">

                    <Path Data="M5,5 L19,5 L19,19 L5,19 Z
                               M8,8 L16,8
                               M8,12 L16,12
                               M8,16 L12,16
                               M12,2 L12,8
                               M9,5 L15,5"
                          Width="25"
                          Height="25"
                          Stretch="Uniform"
                          Stroke="#147FA3"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

                </Border>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Novo Contador"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource DarkBlueBrush}"/>

                    <TextBlock Text="Registe um novo contador e associe-o a um cliente."
                               FontSize="14"
                               Foreground="#6D818D"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </StackPanel>


            <!-- FORMULÁRIO -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#D7E2E8"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="30"
                    Margin="0,0,0,20">

                <Border.Effect>

                    <DropShadowEffect Color="#000000"
                                      BlurRadius="10"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.10"/>

                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="22"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="28"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- TÍTULO DO CARTÃO -->

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Dados do novo contador"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#153F57"/>

                        <TextBlock Text="Preencha os campos abaixo para registar o contador."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="#82939D"/>

                    </StackPanel>


                    <!-- CAMPOS -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="30"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="22"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- CLIENTE -->

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0">

                            <TextBlock Text="Cliente"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <ComboBox x:Name="cmbClientes"
                                      Margin="0,7,0,0"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      DisplayMemberPath="NomeCompleto"
                                      SelectedValuePath="IdCliente"/>

                        </StackPanel>


                        <!-- NÚMERO -->

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2">

                            <TextBlock Text="Número do contador"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtNumeroContador"
                                     Margin="0,7,0,0"
                                     Style="{StaticResource ModernTextBoxStyle}"/>

                        </StackPanel>


                        <!-- DATA -->

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0">

                            <TextBlock Text="Data de instalação"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <DatePicker x:Name="dpDataInstalacao"
                                        Margin="0,7,0,0"
                                        Style="{StaticResource ModernDatePickerStyle}"
                                        DisplayDateEnd="{x:Static sys:DateTime.Today}"/>

                        </StackPanel>


                        <!-- ESTADO -->

                        <StackPanel Grid.Row="2"
                                    Grid.Column="2">

                            <TextBlock Text="Estado"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <Border Height="42"
                                    Margin="0,7,0,0"
                                    Padding="12,0"
                                    Background="#F9FBFC"
                                    BorderBrush="#C9D8E0"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <CheckBox x:Name="chkAtivo"
                                          Content="Contador ativo"
                                          IsChecked="True"
                                          Style="{StaticResource ModernCheckBoxStyle}"
                                          VerticalAlignment="Center"/>

                            </Border>

                        </StackPanel>

                    </Grid>


                    <!-- BOTÕES -->

                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <Border Background="#EDF7FA"
                                BorderBrush="#D1E6ED"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,25,0">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#20A9D2"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock Text="Confirme os dados antes de guardar."
                                           FontSize="12"
                                           Foreground="#31566B"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Button Content="Limpar"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,12,0"
                                    Click="BtnLimpar_Click"/>

                            <Button Content="Guardar"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnGuardar_Click"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>