<UserControl x:Class="WpfFrontEnd.Views.Dashboard.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="18"/>

            <Setter Property="Margin"
                    Value="8"/>

            <Setter Property="BorderBrush"
                    Value="#DDE8ED"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <Style x:Key="CardTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="#60727C"/>

        </Style>

        <Style x:Key="CardValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="26"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#163844"/>

            <Setter Property="Margin"
                    Value="0,10,0,0"/>

        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="5">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CARTÕES DE RESUMO -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Clientes ativos"
                                   Style="{StaticResource CardTitleStyle}"/>

                        <TextBlock x:Name="txtClientesAtivos"
                                   Text="0"
                                   Style="{StaticResource CardValueStyle}"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Consumo mensal"
                                   Style="{StaticResource CardTitleStyle}"/>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock x:Name="txtConsumoMensal"
                                       Text="0"
                                       Style="{StaticResource CardValueStyle}"/>

                            <TextBlock Text=" m³"
                                       FontSize="16"
                                       Foreground="#60727C"
                                       VerticalAlignment="Bottom"
                                       Margin="4,0,0,4"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Faturas pendentes"
                                   Style="{StaticResource CardTitleStyle}"/>

                        <TextBlock x:Name="txtFaturasPendentes"
                                   Text="0"
                                   Style="{StaticResource CardValueStyle}"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Leituras por validar"
                                   Style="{StaticResource CardTitleStyle}"/>

                        <TextBlock x:Name="txtLeiturasValidar"
                                   Text="0"
                                   Style="{StaticResource CardValueStyle}"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- CARTÕES DE NAVEGAÇÃO -->
            <Grid Grid.Row="1"
                  Margin="0,8,0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Height="155">

                    <StackPanel>

                        <TextBlock Text="Clientes"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#163844"/>

                        <TextBlock Text="Cadastro, contactos e situação dos clientes."
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Foreground="#60727C"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Height="155">

                    <StackPanel>

                        <TextBlock Text="Contadores"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#163844"/>

                        <TextBlock Text="Séries, instalação e estado operacional."
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Foreground="#60727C"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Height="155">

                    <StackPanel>

                        <TextBlock Text="Consumos"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#163844"/>

                        <TextBlock Text="Leituras, histórico mensal e análise."
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Foreground="#60727C"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource CardStyle}"
                        Height="155">

                    <StackPanel>

                        <TextBlock Text="Faturas"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#163844"/>

                        <TextBlock Text="Emissão, cobrança e pagamentos."
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Foreground="#60727C"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ATIVIDADE OPERACIONAL -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Margin="8"
                    MinHeight="220">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Atividade operacional"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#163844"
                               Margin="0,0,0,14"/>

                    <DataGrid x:Name="dgAtividade"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Cliente"
                                                Binding="{Binding Cliente}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Contador"
                                                Binding="{Binding Contador}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Leitura"
                                                Binding="{Binding Leitura}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Consumo"
                                                Binding="{Binding Consumo}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding Estado}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>