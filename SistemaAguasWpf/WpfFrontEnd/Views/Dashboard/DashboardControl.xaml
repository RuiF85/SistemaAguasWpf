<UserControl x:Class="WpfFrontEnd.Views.Dashboard.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderBrush" Value="#DDE8ED"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CardTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#60727C"/>
        </Style>

        <Style x:Key="CardValueStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#163844"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="5">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- RESUMO -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                         Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="👥"
                   FontSize="30"
                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="1"
                   x:Name="txtClientesAtivos"
                   Style="{StaticResource CardValueStyle}"
                   Text="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>

                        <TextBlock Grid.Row="2"
                   Text="Clientes ativos"
                   Style="{StaticResource CardTitleStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>

                    </Grid>

                </Border>

                <Border Grid.Column="1"
        Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="💧"
                   FontSize="30"
                   HorizontalAlignment="Center"/>

                        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <TextBlock x:Name="txtConsumoMensal"
                       Style="{StaticResource CardValueStyle}"
                       Text="0"/>

                            <TextBlock Text=" m³"
                       FontSize="16"
                       VerticalAlignment="Bottom"
                       Margin="4,0,0,6"/>

                        </StackPanel>

                        <TextBlock Grid.Row="2"
                   Text="Consumo mensal"
                   Style="{StaticResource CardTitleStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>

                    </Grid>

                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="🧾"
                   FontSize="30"
                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="1"
                   x:Name="txtFaturasPendentes"
                   Style="{StaticResource CardValueStyle}"
                   Text="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>

                        <TextBlock Grid.Row="2"
                   Text="Faturas pendentes"
                   Style="{StaticResource CardTitleStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>

                    </Grid>

                </Border>
                <Border Grid.Column="2"
        Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="📋"
                   FontSize="30"
                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="1"
                   x:Name="txtLeiturasValidar"
                   Style="{StaticResource CardValueStyle}"
                   Text="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>

                        <TextBlock Grid.Row="2"
                   Text="Leituras por validar"
                   Style="{StaticResource CardTitleStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>

                    </Grid>

                </Border>

            </Grid>

            <!-- SEGUNDA LINHA -->
            <Grid Grid.Row="1"
                  Margin="0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Height="155">

                    <StackPanel>

                        <TextBlock Text="👤 Clientes"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#163844"/>

                        <TextBlock x:Name="txtTotalClientes"
                                   Style="{StaticResource CardValueStyle}"/>

                        <TextBlock Text="Clientes registados no sistema."
                                   Margin="0,8,0,0"
                                   Foreground="#60727C"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Height="155">

                    <StackPanel>

                        <TextBlock Text="⚙ Contadores"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#163844"/>

                        <TextBlock x:Name="txtTotalContadores"
                                   Style="{StaticResource CardValueStyle}"/>

                        <TextBlock Text="Contadores instalados."
                                   Margin="0,8,0,0"
                                   Foreground="#60727C"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Height="155">

                    <StackPanel>

                        <TextBlock Text="💧 Consumos"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#163844"/>

                        <TextBlock x:Name="txtTotalConsumos"
                                   Style="{StaticResource CardValueStyle}"/>

                        <TextBlock Text="Leituras registadas."
                                   Margin="0,8,0,0"
                                   Foreground="#60727C"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource CardStyle}"
                        Height="155">

                    <StackPanel>

                        <TextBlock Text="🧾 Valor faturado"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#163844"/>

                        <TextBlock x:Name="txtValorFaturado"
                                   Style="{StaticResource CardValueStyle}"/>

                        <TextBlock Text="Total faturado pelo sistema."
                                   Margin="0,8,0,0"
                                   Foreground="#60727C"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ATIVIDADE OPERACIONAL -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Margin="8"
                    MinHeight="320">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Atividade operacional"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#163844"
                               Margin="0,0,0,15"/>

                    <DataGrid x:Name="dgAtividade"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E5E5"
                              BorderThickness="0"
                              Background="White"
                              RowHeight="34"
                              AlternatingRowBackground="#F8FBFD"
                              ColumnWidth="*">

                        <DataGrid.Resources>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EDF4F8"/>
                                <Setter Property="Foreground" Value="#163844"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#D7E2E8"/>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,4"/>
                            </Style>

                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Cliente"
                                                Binding="{Binding Cliente}"
                                                Width="2*" />

                            <DataGridTextColumn Header="N.º Contador"
                                                Binding="{Binding Contador}"
                                                Width="1.5*" />

                            <DataGridTextColumn Header="Data da leitura"
                                                Binding="{Binding Leitura}"
                                                Width="1.4*" />

                            <DataGridTextColumn Header="Consumo"
                                                Binding="{Binding Consumo}"
                                                Width="1.2*" />

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding Estado}"
                                                Width="1.2*" />

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>