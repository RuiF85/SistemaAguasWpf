<UserControl x:Class="WpfFrontEnd.Views.Faturas.GerarFaturaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF4F7"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="950">

    <UserControl.Resources>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#147FA3"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#1998C2"/>

        <SolidColorBrush x:Key="PrimaryPressedBrush"
                         Color="#075C7A"/>

        <SolidColorBrush x:Key="DarkBlueBrush"
                         Color="#083B5C"/>

        <SolidColorBrush x:Key="InputBorderBrush"
                         Color="#C3D4DC"/>

        <SolidColorBrush x:Key="InputBackgroundBrush"
                         Color="#FFFFFF"/>


        <Style x:Key="FormLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#36586A"/>

        </Style>


        <Style x:Key="ModernComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#243B4A"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource InputBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="#75B5C9"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="{StaticResource PrimaryBrush}"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Background"
                            Value="#EDF2F4"/>

                    <Setter Property="Opacity"
                            Value="0.65"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="InformationBorderStyle"
               TargetType="Border">

            <Setter Property="MinHeight"
                    Value="68"/>

            <Setter Property="Background"
                    Value="#F8FBFC"/>

            <Setter Property="BorderBrush"
                    Value="#D6E3E9"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="9"/>

            <Setter Property="Padding"
                    Value="14,9"/>

        </Style>


        <Style x:Key="SummaryBorderStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F7FBFC"/>

            <Setter Property="BorderBrush"
                    Value="#D5E5EB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="9"/>

            <Setter Property="Padding"
                    Value="14,11"/>

        </Style>


        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#31566B"/>

            <Setter Property="Background"
                    Value="#E8F1F5"/>

            <Setter Property="BorderBrush"
                    Value="#BDD2DC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D5E8EF"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#83B8CA"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#BFDCE6"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="155"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="#5EC4E3"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <Border.Effect>

                                <DropShadowEffect Color="#147FA3"
                                                  BlurRadius="8"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Opacity="0.22"/>

                            </Border.Effect>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <Path Data="M5,3 L16,3 L21,8 L21,22 L5,22 Z
                                           M16,3 L16,8 L21,8
                                           M9,12 L17,12
                                           M9,16 L17,16
                                           M9,20 L14,20"
                                      Width="18"
                                      Height="18"
                                      Margin="0,0,8,0"
                                      Stretch="Uniform"
                                      Stroke="White"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>

                                <ContentPresenter VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryPressedBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="ModernDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserSortColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="RowHeaderWidth"
                    Value="0"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E1EAEE"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#F7FAFB"/>

            <Setter Property="RowHeight"
                    Value="43"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="44"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="#294654"/>

        </Style>


        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#E9F3F7"/>

            <Setter Property="Foreground"
                    Value="#16445B"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderBrush"
                    Value="#D2E1E7"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <Style TargetType="DataGridRow">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#EAF6FA"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="35">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="25"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">

                <Border Width="48"
                        Height="48"
                        Background="#DDF3F9"
                        CornerRadius="24"
                        Margin="0,0,14,0">

                    <Path Data="M5,3 L16,3 L21,8 L21,22 L5,22 Z
                               M16,3 L16,8 L21,8
                               M9,12 L17,12
                               M9,16 L17,16
                               M9,20 L14,20"
                          Width="25"
                          Height="25"
                          Stretch="Uniform"
                          Stroke="#147FA3"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

                </Border>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Gerar Fatura"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource DarkBlueBrush}"/>

                    <TextBlock Text="Selecione um consumo e confirme os dados antes de emitir a fatura."
                               FontSize="14"
                               Foreground="#6D818D"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </StackPanel>


            <StackPanel Grid.Row="2">


                <Border Background="White"
                        BorderBrush="#D7E2E8"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="30">

                    <Border.Effect>

                        <DropShadowEffect Color="#000000"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Opacity="0.10"/>

                    </Border.Effect>

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="22"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="25"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Dados da faturação"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#153F57"/>

                            <TextBlock Text="A informação será preenchida automaticamente com base no consumo selecionado."
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#82939D"/>

                        </StackPanel>


                        <StackPanel Grid.Row="2">

                            <TextBlock Text="Consumo a faturar"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <ComboBox x:Name="cmbConsumos"
                                      Margin="0,8,0,0"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      SelectedValuePath="IdConsumo"
                                      SelectionChanged="CmbConsumos_SelectionChanged">

                                <ComboBox.ItemTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="Consumo #"
                                                       Foreground="#526B79"/>

                                            <TextBlock Text="{Binding IdConsumo}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#24495D"/>

                                            <TextBlock Text="  |  Data: "
                                                       Foreground="#82939D"/>

                                            <TextBlock Text="{Binding Data,
                                                               StringFormat={}{0:dd/MM/yyyy}}"
                                                       Foreground="#526B79"/>

                                            <TextBlock Text="  |  Consumo: "
                                                       Foreground="#82939D"/>

                                            <TextBlock Text="{Binding ConsumoCalculado,
                                                               StringFormat={}{0:N2} m³}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#147FA3"/>

                                        </StackPanel>

                                    </DataTemplate>

                                </ComboBox.ItemTemplate>

                            </ComboBox>

                            <TextBlock x:Name="txtSemConsumos"
                                       Text="Não existem consumos disponíveis para faturação."
                                       FontSize="12"
                                       Foreground="#C04A4A"
                                       Margin="2,7,0,0"
                                       Visibility="Collapsed"/>

                        </StackPanel>


                        <Grid Grid.Row="4">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource InformationBorderStyle}">

                                <StackPanel>

                                    <TextBlock Text="N.º da fatura"
                                               FontSize="11"
                                               Foreground="#82939D"/>

                                    <TextBlock x:Name="txtNumeroFatura"
                                               Text="—"
                                               Margin="0,5,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#24495D"/>

                                </StackPanel>

                            </Border>


                            <Border Grid.Column="2"
                                    Style="{StaticResource InformationBorderStyle}">

                                <StackPanel>

                                    <TextBlock Text="N.º do contrato"
                                               FontSize="11"
                                               Foreground="#82939D"/>

                                    <TextBlock x:Name="txtNumeroContrato"
                                               Text="—"
                                               Margin="0,5,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#24495D"/>

                                </StackPanel>

                            </Border>


                            <Border Grid.Column="4"
                                    Style="{StaticResource InformationBorderStyle}">

                                <StackPanel>

                                    <TextBlock Text="N.º do consumo"
                                               FontSize="11"
                                               Foreground="#82939D"/>

                                    <TextBlock x:Name="txtIdConsumo"
                                               Text="—"
                                               Margin="0,5,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#24495D"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Grid>

                </Border>


                <Border Background="White"
                        BorderBrush="#D7E2E8"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="30"
                        Margin="0,25,0,0">

                    <Border.Effect>

                        <DropShadowEffect Color="#000000"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Opacity="0.10"/>

                    </Border.Effect>

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="22"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="18"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Cliente e contrato"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#153F57"/>

                            <TextBlock Text="Dados associados ao contrato do contador."
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#82939D"/>

                        </StackPanel>


                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource InformationBorderStyle}">

                                <StackPanel>

                                    <TextBlock Text="Titular do contrato"
                                               FontSize="11"
                                               Foreground="#82939D"/>

                                    <TextBlock x:Name="txtTitularContrato"
                                               Text="—"
                                               Margin="0,5,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#24495D"
                                               TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </Border>


                            <Border Grid.Column="2"
                                    Style="{StaticResource InformationBorderStyle}">

                                <StackPanel>

                                    <TextBlock Text="Morada do contrato"
                                               FontSize="11"
                                               Foreground="#82939D"/>

                                    <TextBlock x:Name="txtMoradaContrato"
                                               Text="—"
                                               Margin="0,5,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#24495D"
                                               TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </Border>

                        </Grid>


                        <Grid Grid.Row="4">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource InformationBorderStyle}">

                                <StackPanel>

                                    <TextBlock Text="Data da leitura"
                                               FontSize="11"
                                               Foreground="#82939D"/>

                                    <TextBlock x:Name="txtDataConsumo"
                                               Text="—"
                                               Margin="0,5,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#24495D"/>

                                </StackPanel>

                            </Border>


                            <Border Grid.Column="2"
                                    Style="{StaticResource InformationBorderStyle}">

                                <StackPanel>

                                    <TextBlock Text="Data da fatura"
                                               FontSize="11"
                                               Foreground="#82939D"/>

                                    <TextBlock x:Name="txtDataFatura"
                                               Text="—"
                                               Margin="0,5,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#24495D"/>

                                </StackPanel>

                            </Border>


                            <Border Grid.Column="4"
                                    Style="{StaticResource InformationBorderStyle}">

                                <StackPanel>

                                    <TextBlock Text="Data limite de pagamento"
                                               FontSize="11"
                                               Foreground="#82939D"/>

                                    <TextBlock x:Name="txtDataLimitePagamento"
                                               Text="—"
                                               Margin="0,5,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#24495D"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Grid>

                </Border>


                <Border Background="White"
                        BorderBrush="#D7E2E8"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="30"
                        Margin="0,25,0,0">

                    <Border.Effect>

                        <DropShadowEffect Color="#000000"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Opacity="0.10"/>

                    </Border.Effect>

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="20"/>

                            <RowDefinition Height="230"/>

                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Cálculo por escalões"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#153F57"/>

                            <TextBlock Text="Distribuição do consumo e respetivo valor por escalão."
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#82939D"/>

                        </StackPanel>


                        <Border Grid.Row="2"
                                BorderBrush="#D8E4E9"
                                BorderThickness="1"
                                CornerRadius="9"
                                ClipToBounds="True">

                            <DataGrid x:Name="dgEscaloes"
                                      Style="{StaticResource ModernDataGridStyle}">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Escalão"
                                                        Binding="{Binding Escalao}"
                                                        Width="120"/>

                                    <DataGridTextColumn Header="Intervalo"
                                                        Binding="{Binding Intervalo}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Valor unitário"
                                                        Binding="{Binding ValorUnitario,
                                                        StringFormat={}{0:N2} €}"
                                                        Width="150"/>

                                    <DataGridTextColumn Header="Consumo aplicado"
                                                        Binding="{Binding ConsumoAplicado,
                                                        StringFormat={}{0:N2} m³}"
                                                        Width="170"/>

                                    <DataGridTextColumn Header="Total"
                                                        Binding="{Binding Total,
                                                        StringFormat={}{0:N2} €}"
                                                        Width="140"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Border>

                    </Grid>

                </Border>


                <Border Background="White"
                        BorderBrush="#D7E2E8"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="30"
                        Margin="0,25,0,20">

                    <Border.Effect>

                        <DropShadowEffect Color="#000000"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Opacity="0.10"/>

                    </Border.Effect>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="30"/>

                            <ColumnDefinition Width="370"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Bottom">

                            <Border Background="#EDF7FA"
                                    BorderBrush="#D1E6ED"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10">

                                <StackPanel Orientation="Horizontal">

                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="#20A9D2"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Confirme os dados e os valores antes de gerar a fatura."
                                               FontSize="12"
                                               Foreground="#31566B"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>


                            <StackPanel Orientation="Horizontal"
                                        Margin="0,20,0,0">

                                <Button Content="Limpar"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,12,0"
                                        Click="BtnLimpar_Click"/>

                                <Button x:Name="btnGerarFatura"
                                        Content="Gerar Fatura"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnGerarFatura_Click"/>

                            </StackPanel>

                        </StackPanel>


                        <Border Grid.Column="2"
                                Background="#F7FBFC"
                                BorderBrush="#CFE2E9"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Resumo da fatura"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#153F57"
                                           Margin="0,0,0,15"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Consumo total"
                                               FontSize="13"
                                               Foreground="#526B79"/>

                                    <TextBlock x:Name="txtConsumoCalculado"
                                               Grid.Column="1"
                                               Text="0,00 m³"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#24495D"/>

                                </Grid>


                                <Grid Margin="0,12,0,0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Subtotal"
                                               FontSize="13"
                                               Foreground="#526B79"/>

                                    <TextBlock x:Name="txtSubtotal"
                                               Grid.Column="1"
                                               Text="0,00 €"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#24495D"/>

                                </Grid>


                                <Grid Margin="0,12,0,0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                 

                                </Grid>


                                <Border Height="1"
                                        Background="#D5E4E9"
                                        Margin="0,16,0,14"/>


                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Total final"
